  "formulas": {
    "disk-bandwidth": {
      "tests": [
        "sequential-read",
        "sequential-write"
      ],
      "aria_label": "The bandwidth in MiB per second is the bytes per second fio reports divided by 1,048,576.",
      "tex": "\\mathrm{BW}_{\\mathrm{MiB/s},\\,i} = \\dfrac{B_i}{1{,}048{,}576}",
      "variables": [
        {
          "symbol": "\\mathrm{BW}_{\\mathrm{MiB/s},\\,i}",
          "definition": "Binary megabytes per second in trial i (1 MiB = 2^20 bytes = 1,048,576 bytes)."
        },
        {
          "symbol": "B_i",
          "definition": "The bytes per second fio reports over the 60 s measured interval in trial i."
        }
      ]
    },
    "hard-links": {
      "aria_label": "The hard-link rate is the hard links created divided by the elapsed time of the stress-ng run.",
      "tex": "R_{\\mathrm{links},\\,i} = \\dfrac{L_{\\mathrm{created},\\,i}}{T_{\\mathrm{stressor},\\,i}}",
      "variables": [
        {
          "symbol": "R_{\\mathrm{links},\\,i}",
          "definition": "Hard links per second in trial i."
        },
        {
          "symbol": "L_{\\mathrm{created},\\,i}",
          "definition": "Total number of hard links successfully created across all rounds in trial i."
        },
        {
          "symbol": "T_{\\mathrm{stressor},\\,i}",
          "definition": "stress-ng's internal elapsed wall-clock time in seconds in trial i (approximately 30 s), which spans both creating the hard links and unlinking them at the end of each round."
        }
      ]
    },
    "time-index": {
      "aria_label": "Composite time is the geometric mean of workload times.",
      "tex": "T = \\left( \\prod_{k=1}^{n} t_k \\right)^{1/n}",
      "variables": [
        {
          "symbol": "T",
          "definition": "Composite workload time."
        },
        {
          "symbol": "t_k",
          "definition": "Time for workload k, with the missing-result policy applied."
        },
        {
          "symbol": "n",
          "definition": "Number of workloads in the selected scope."
        }
      ]
    },
    "cost-index": {
      "aria_label": "Composite cost is the geometric mean of workload costs.",
      "tex": "C = \\left( \\prod_{k=1}^{n} c_k \\right)^{1/n}",
      "variables": [
        {
          "symbol": "C",
          "definition": "Composite workload cost."
        },
        {
          "symbol": "c_k",
          "definition": "Cost for workload k, with the missing-result policy applied."
        },
        {
          "symbol": "n",
          "definition": "Number of workloads in the selected scope."
        }
      ]
    },
    "r2e-gym": {
      "aria_label": "Group time is the sum of every timed span across the group's five sandboxes.",
      "tex": "T = c + r + s + \\sum_{k=1}^{4} \\left( p_k + u_k + w_k \\right) + \\sum_{j=1}^{5} d_j",
      "variables": [
        {
          "symbol": "T",
          "definition": "Group time: the sum of every timed span across all five sandboxes of a trial."
        },
        {
          "symbol": "c",
          "definition": "Create time of sandbox 1, on the job host's clock."
        },
        {
          "symbol": "r",
          "definition": "Reset time of sandbox 1, the in-sandbox runtime of the environment reset."
        },
        {
          "symbol": "s",
          "definition": "Snapshot time of sandbox 1, on the job host's clock."
        },
        {
          "symbol": "p_k",
          "definition": "Create-from-snapshot time of rollout k, on the job host's clock."
        },
        {
          "symbol": "u_k",
          "definition": "Tool-call time of rollout k, the in-sandbox runtime of its recorded tool calls."
        },
        {
          "symbol": "w_k",
          "definition": "Reward time of rollout k, the in-sandbox runtime of the task's test suite."
        },
        {
          "symbol": "d_j",
          "definition": "Destroy time of sandbox j, on the job host's clock. The job host's times include network transport; the in-sandbox runtimes are measured by each sandbox's own clock and validated against `/proc/uptime`."
        }
      ]
    },
    "burst-tti": {
      "aria_label": "Burst time is the time from the first create request to the last sandbox's first successful command.",
      "tex": "T_i = \\max_{j} \\left( e_{i,j} \\right) - \\min_{j} \\left( s_{i,j} \\right)",
      "variables": [
        {
          "symbol": "T_i",
          "definition": "Burst time of trial i, defined when all N sandboxes succeed."
        },
        {
          "symbol": "s_{i,j}",
          "definition": "Job-host timestamp when sandbox j's create call is sent."
        },
        {
          "symbol": "e_{i,j}",
          "definition": "Job-host timestamp when sandbox j's first successful true attempt returns exit code 0."
        }
      ]
    },
    "exec-latency-per-100-calls": {
      "aria_label": "Time per 100 calls is the sum of the job-host round-trip times of the 100 calls in a trial.",
      "tex": "T_i = \\sum_{c=1}^{100} t_{i,c}",
      "variables": [
        {
          "symbol": "T_i",
          "definition": "Time of the 100 calls in trial i."
        },
        {
          "symbol": "t_{i,c}",
          "definition": "Job-host round-trip time of call c in trial i, from the start of the request until the exit code and guest clock readings return."
        }
      ]
    },
    "exec-latency": {
      "tests": [
        "exec-latency-per-100-calls"
      ],
      "aria_label": "Time per call is the median job-host round-trip time over every call of every successful trial.",
      "tex": "\\tilde{t} = \\operatorname{median}_{i,c} \\left( t_{i,c} \\right), \\quad L_{i,c} = t_{i,c} - r_{i,c}",
      "variables": [
        {
          "symbol": "\\tilde{t}",
          "definition": "Median round-trip time of one call, taken over all calls of all successful trials."
        },
        {
          "symbol": "t_{i,c}",
          "definition": "Job-host round-trip time of call c in trial i, from the start of the request until the exit code and guest clock readings return."
        },
        {
          "symbol": "r_{i,c}",
          "definition": "Runtime of call c in trial i: the in-sandbox duration between the two `$EPOCHREALTIME` readings around `true`, close to zero because `true` is a shell builtin."
        },
        {
          "symbol": "L_{i,c}",
          "definition": "Latency is the total time minus the runtime of a call, capturing network transit, the provider's exec API, and the provider's process that starts the command inside the sandbox."
        }
      ]
    },
    "files": {
      "tests": [
        "list",
        "write-4kib",
        "read-4kib"
      ],
      "aria_label": "A trial's value is the median job-host duration over its repetitions of the operation.",
      "tex": "M_{\\mathrm{op},\\,i} = \\operatorname{median}_{r} \\left( t_{\\mathrm{op},\\,i,\\,r} \\right)",
      "variables": [
        {
          "symbol": "M_{\\mathrm{op},\\,i}",
          "definition": "Summary value of operation op in trial i, the nearest-rank median across its repetitions."
        },
        {
          "symbol": "t_{\\mathrm{op},\\,i,\\,r}",
          "definition": "Job-host duration of repetition r of operation op in trial i."
        }
      ]
    },
    "7-zip-total-rating": {
      "tests": [
        "7-zip-1-thread",
        "7-zip-all-vcpus"
      ],
      "aria_label": "The total rating is the mean of the compression and decompression ratings.",
      "tex": "R_{\\mathrm{total},\\,i} = \\dfrac{R_{\\mathrm{compress},\\,i} + R_{\\mathrm{decompress},\\,i}}{2}",
      "variables": [
        {
          "symbol": "R_{\\mathrm{total},\\,i}",
          "definition": "Total rating in MIPS of trial i: the mean of its compression and decompression ratings."
        },
        {
          "symbol": "R_{\\mathrm{compress},\\,i}",
          "definition": "Compression rating in MIPS of trial i."
        },
        {
          "symbol": "R_{\\mathrm{decompress},\\,i}",
          "definition": "Decompression rating in MIPS of trial i."
        }
      ]
    },
    "reconnect": {
      "aria_label": "Reconnect time is the median attach time plus the median first-command time over a trial's rounds.",
      "tex": "T_i = \\operatorname{median}_{r} \\left( a_{i,r} \\right) + \\operatorname{median}_{r} \\left( c_{i,r} \\right), \\quad L_{i,r} = c_{i,r} - q_{i,r}",
      "variables": [
        {
          "symbol": "T_i",
          "definition": "Reconnect time of trial i: the sum of its median attach time and its median first-command time across its rounds."
        },
        {
          "symbol": "a_{i,r}",
          "definition": "Job-host duration of the attach lookup in round r of trial i."
        },
        {
          "symbol": "c_{i,r}",
          "definition": "Job-host duration of the first `true` command in round r of trial i."
        },
        {
          "symbol": "q_{i,r}",
          "definition": "Runtime of the first `true` command in round r of trial i, on the sandbox's guest clock; the median over the rounds is recorded per trial."
        },
        {
          "symbol": "L_{i,r}",
          "definition": "Latency is the median over a trial's rounds of the first command's total time minus its runtime."
        }
      ]
    },
    "stream-triad": {
      "aria_label": "The best Triad rate in gigabytes per second is the bytes moved by one pass divided by the shortest pass time.",
      "tex": "B_{\\mathrm{Triad},\\,i} = \\dfrac{B_{\\mathrm{Triad,MB/s},\\,i}}{1000} = \\dfrac{3 \\times 8 \\times N_{\\mathrm{elem}}}{\\min_{p \\in \\{2,\\,\\dots,\\,20\\}} t_{i,p} \\times 10^{9}}",
      "variables": [
        {
          "symbol": "B_{\\mathrm{Triad},\\,i}",
          "definition": "Best Triad rate of trial i in decimal gigabytes per second (10^9 bytes/s), rounded to three decimal places."
        },
        {
          "symbol": "B_{\\mathrm{Triad,MB/s},\\,i}",
          "definition": "Best Triad rate of trial i as STREAM prints it, in 10^6 bytes/s."
        },
        {
          "symbol": "N_{\\mathrm{elem}}",
          "definition": "Number of 8-byte double elements per array, 80,000,000."
        },
        {
          "symbol": "t_{i,p}",
          "definition": "Elapsed time in seconds of pass p in trial i on STREAM's internal clock, for passes 2 to 20."
        }
      ]
    },
    "tool-time": {
      "tests": [
        "ci-jobs",
        "deepswe",
        "terminal-bench-4-0"
      ],
      "aria_label": "Tool time or job time is the sum of the command or step runtimes on the sandbox's clock.",
      "tex": "T = \\sum_{k=1}^{K} \\left( e_k - s_k \\right)",
      "variables": [
        {
          "symbol": "T",
          "definition": "Tool time of a replay, or job time of a CI job: the sum of its command or step runtimes on the sandbox's clock."
        },
        {
          "symbol": "K",
          "definition": "Number of commands or steps in the trace, session or job."
        },
        {
          "symbol": "s_k",
          "definition": "The script's `$EPOCHREALTIME` reading immediately before command or step k."
        },
        {
          "symbol": "e_k",
          "definition": "The script's `$EPOCHREALTIME` reading immediately after command or step k."
        }
      ]
    },
    "common-latency": {
      "tests": [
        "sbs.common"
      ],
      "name": "Latency",
      "aria_label": "Latency is the total time minus the runtime.",
      "tex": "t_{\\mathrm{latency}} = t_{\\mathrm{total}} - t_{\\mathrm{runtime}}",
      "variables": [
        {
          "symbol": "t_{\\mathrm{latency}}",
          "definition": "Latency: the difference of the total time and the runtime of a timed span."
        },
        {
          "symbol": "t_{\\mathrm{total}}",
          "definition": "Total time: the operation duration of a timed span, measured on the job host."
        },
        {
          "symbol": "t_{\\mathrm{runtime}}",
          "definition": "Runtime: the command duration of a timed span, measured on the sandbox's own clock."
        }
      ]
    },
    "common-clock-gate": {
      "tests": [
        "sbs.common"
      ],
      "name": "Clock Gate",
      "aria_label": "A guest runtime is accepted when the wall-clock and uptime spans are not negative and differ by at most 20 milliseconds.",
      "tex": "\\Delta t_{\\mathrm{wall}} \\ge 0, \\quad \\Delta t_{\\mathrm{up}} \\ge 0, \\quad \\text{and} \\quad \\left| \\Delta t_{\\mathrm{wall}} - \\Delta t_{\\mathrm{up}} \\right| \\le 20\\ \\text{ms}",
      "variables": [
        {
          "symbol": "\\Delta t_{\\mathrm{wall}}",
          "definition": "Elapsed time of the timed span from the start s and end e $EPOCHREALTIME readings: e - s."
        },
        {
          "symbol": "\\Delta t_{\\mathrm{up}}",
          "definition": "Elapsed /proc/uptime duration over the same span."
        }
      ]
    },
    "common-percentile": {
      "tests": [
        "sbs.common"
      ],
      "name": "Nearest-Rank Percentile",
      "aria_label": "The nearest-rank percentile is the value at rank r, the larger of 1 and the ceiling of p over 100 times n.",
      "tex": "Q_p = x_{(r)}, \\quad r = \\max\\left( 1,\\ \\left\\lceil \\dfrac{p}{100} \\times n \\right\\rceil \\right)",
      "variables": [
        {
          "symbol": "Q_p",
          "definition": "The nearest-rank percentile p of a unit's successful trials."
        },
        {
          "symbol": "x_{(r)}",
          "definition": "The value at rank r of the unit's n successful trials sorted in ascending order."
        },
        {
          "symbol": "r",
          "definition": "The rank."
        },
        {
          "symbol": "p",
          "definition": "The percentile, from 0 to 100."
        },
        {
          "symbol": "n",
          "definition": "The number of successful trials of the unit."
        }
      ]
    },
    "common-mean": {
      "tests": [
        "sbs.common"
      ],
      "name": "Mean",
      "aria_label": "The mean is the sum of the n successful trial values divided by n.",
      "tex": "x_{\\mathrm{mean}} = \\dfrac{x_1 + \\cdots + x_n}{n}",
      "variables": [
        {
          "symbol": "x_{\\mathrm{mean}}",
          "definition": "The arithmetic mean of a unit's successful trial values."
        },
        {
          "symbol": "x_1",
          "definition": "The first successful trial's value."
        },
        {
          "symbol": "x_n",
          "definition": "The last successful trial's value."
        },
        {
          "symbol": "n",
          "definition": "The number of successful trials of the unit."
        }
      ]
    },
    "common-workload-value": {
      "tests": [
        "sbs.common"
      ],
      "aria_label": "A workload value is the geometric mean of a provider's per-unit medians.",
      "tex": "T_p = \\left( \\prod_{u \\in U} m_{p,u} \\right)^{1/|U|}",
      "variables": [
        {
          "symbol": "T_p",
          "definition": "Workload value of provider p: the geometric mean of its per-unit medians."
        },
        {
          "symbol": "m_{p,u}",
          "definition": "Provider p's median on unit u."
        },
        {
          "symbol": "U",
          "definition": "The set of units completed by at least one provider; |U| is the number of units in it."
        }
      ]
    },
    "common-trial-cost": {
      "tests": [
        "sbs.common"
      ],
      "name": "Trial Cost",
      "aria_label": "The cost of a trial is the sum of the costs of the sandboxes it created.",
      "tex": "c_i = \\sum_{s} c_{i,s}",
      "variables": [
        {
          "symbol": "c_i",
          "definition": "Provider-sourced cost of successful trial i: the sum of the costs of the sandboxes created during trial i."
        },
        {
          "symbol": "c_{i,s}",
          "definition": "Provider-sourced cost of sandbox s in trial i."
        }
      ]
    },
    "common-stage-cost": {
      "tests": [
        "sbs.common"
      ],
      "name": "Stage Cost",
      "aria_label": "A stage's cost is the unit's displayed cost times the stage's share of the time.",
      "tex": "c_s = C \\times \\dfrac{t_s}{t}",
      "variables": [
        {
          "symbol": "c_s",
          "definition": "The cost of stage s."
        },
        {
          "symbol": "C",
          "definition": "The unit's displayed cost."
        },
        {
          "symbol": "t_s",
          "definition": "Stage s's time."
        },
        {
          "symbol": "t",
          "definition": "The total time across stages."
        }
      ]
    }
  },
