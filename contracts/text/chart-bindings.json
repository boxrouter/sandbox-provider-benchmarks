{
 "schema": "boxrouter.bench.chart-bindings/3",
 "bindings": [
  {
   "document": "deepswe",
   "charts": {
    "time-trace": {
     "metric": "tool_time",
     "statistic": "selected"
    },
    "time-trace-set": {
     "metric": "tool_time_set_total",
     "statistic": "sum"
    },
    "cost-trace": {
     "metric": "cost_per_success",
     "statistic": "mean"
    },
    "time-typical-trace": {
     "metric": "tool_time",
     "statistic": "geometric_mean"
    }
   },
   "derived_metrics": {
    "cost_per_success": {
     "field": "cost.per_success",
     "unit": "USD",
     "per": "trace",
     "statistic": "mean",
     "kind": "cost"
    }
   }
  },
  {
   "document": "terminal-bench-4-0",
   "charts": {
    "cost-session": {
     "metric": "cost_per_success",
     "statistic": "mean"
    }
   },
   "derived_metrics": {
    "cost_per_success": {
     "field": "cost.per_success",
     "unit": "USD",
     "per": "trace",
     "statistic": "mean",
     "kind": "cost"
    }
   }
  },
  {
   "document": "r2e-gym",
   "charts": {
    "time-rollout-tools": {
     "metric": "tool_time",
     "statistic": "selected"
    },
    "time-rollout-reward": {
     "metric": "reward_time",
     "statistic": "selected"
    },
    "cost-trial": {
     "metric": "cost_per_success",
     "statistic": "mean"
    },
    "time-trial": {
     "metric": "pipeline_time",
     "statistic": "selected"
    },
    "time-overall": {
     "metric": "pipeline_time",
     "statistic": "geometric_mean"
    }
   },
   "derived_metrics": {
    "cost_per_success": {
     "field": "cost.per_success",
     "unit": "USD",
     "per": "trial",
     "statistic": "mean",
     "kind": "cost"
    },
    "pipeline_time": {
     "kind": "sum",
     "unit": "ms",
