     "statistic": "median",
     "terms": {
      "create": "request-elapsed",
      "reset": "command-runtime",
      "snapshot": "request-elapsed",
      "restore": "request-elapsed",
      "cmd": "command-runtime",
      "reward": "command-runtime",
      "destroy": "request-elapsed"
     }
    }
   }
  },
  {
   "document": "github-actions",
   "charts": {
    "time-job": {
     "metric": "job_time",
     "statistic": "selected"
    },
    "cost-job": {
     "metric": "cost_per_success",
     "statistic": "mean"
    }
   },
   "derived_metrics": {
    "cost_per_success": {
     "field": "cost.per_success",
     "unit": "USD",
     "per": "job",
     "statistic": "mean",
     "kind": "cost"
    }
   }
