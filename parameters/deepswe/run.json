{
  "$schema": "../../schemas/run-definition.schema.json",
  "schema": "boxrouter.bench.run/1",
  "id": "deepswe",
  "version": 1,
  "variants": "workloads.json",
  "sandboxes": 1,
  "kind": "machine-performance",
  "machine": {
    "vcpu": 4,
    "memory_gib": 8
  },
  "lifetime_s": 1500,
  "handler": "replay",
  "replay": {
    "trace": "deepswe",
    "network": "deny",
    "shell": "sh",
    "directories": [
      "/logs/artifacts"
    ]
  },
  "steps": [
    {
      "id": "create",
      "op": "create",
      "timeout_s": 600
    },
    {
      "id": "cmd",
      "op": "exec",
      "command": "recorded",
      "timeout_s": 600
    },
    {
      "id": "destroy",
      "op": "destroy",
      "timeout_s": 300
    }
  ]
}
