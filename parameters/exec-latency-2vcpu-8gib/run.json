{
  "$schema": "../../schemas/run-definition.schema.json",
  "schema": "boxrouter.bench.run/1",
  "id": "exec-latency-2vcpu-8gib",
  "version": 1,
  "variants": "workloads.json",
  "sandboxes": 1,
  "kind": "operation",
  "machine": { "vcpu": 2, "memory_gib": 8 },
  "lifetime_s": 600,
  "steps": [
    { "id": "create", "op": "create", "timeout_s": 300 },
    {
      "id": "ready",
      "op": "exec",
      "untimed": true,
      "command": "{param:command}",
      "timeout_s": 30
    },
    {
      "id": "true",
      "op": "exec",
      "command": "{param:command}",
      "repeat": "{param:calls}",
      "clock_reads": true,
      "timeout_s": 30
    },
    { "id": "destroy", "op": "destroy", "timeout_s": 300 }
  ]
}
